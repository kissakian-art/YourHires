  id         Int              @id @default(autoincrement())
  templateId Int              @map("template_id")
  template   FunctionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemType   String           @map("item_type") @db.VarChar(20) // item, asset
  itemId     Int?             @map("item_id")
  item       Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  assetId    Int?             @map("asset_id")
  asset      SerializedAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity   Int              @default(1)
  notes      String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("function_template_items")
}

model FunctionIssue {
  id              Int           @id @default(autoincrement())
  companyId       Int           @map("company_id")
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  functionId      Int           @map("function_id")
  function        FunctionEvent @relation(fields: [functionId], references: [id], onDelete: Cascade)
  title           String        @db.VarChar(255)
  description     String        @db.Text
  severity        String        @default("Medium") @db.VarChar(50) // Low, Medium, High, Critical
  status          String        @default("Reported") @db.VarChar(50) // Reported, Under_Review, Resolved, Closed
  resolutionNotes String?       @map("resolution_notes") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("function_issues")
}

model Income {
  id               Int      @id @default(autoincrement())
  companyId        Int      @map("company_id")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency         String   @default("UGX") @db.VarChar(10)
  incomeSource     String   @map("income_source") @db.VarChar(50) // rental_order, booking_deposit, late_fee, damage_fee, invoice_payment, manual
  amount           Decimal  @db.Decimal(10, 2)
  paymentMethod    String   @map("payment_method") @db.VarChar(50) // cash, check, credit_card, bank_transfer, stripe, mobile_money, other
  paymentDate      DateTime @default(now()) @map("payment_date")
  referenceNumber  String?  @map("reference_number") @db.VarChar(100)
  description      String   @db.Text
  baseRentalAmount Decimal  @default(0.00) @map("base_rental_amount") @db.Decimal(10, 2)
  lateFeeAmount    Decimal  @default(0.00) @map("late_fee_amount") @db.Decimal(10, 2)
  damageFeeAmount  Decimal  @default(0.00) @map("damage_fee_amount") @db.Decimal(10, 2)
  depositAmount    Decimal  @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)
  otherFeeAmount   Decimal  @default(0.00) @map("other_fee_amount") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("income_records")
}

model Consumable {
  id           Int             @id @default(autoincrement())
  companyId    Int             @map("company_id")
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String          @db.VarChar(255)
  category     String          @default("general") @db.VarChar(100)
  stockQty     Int             @default(0) @map("stock_qty")
  restockLevel Int             @default(0) @map("restock_level")
  unitPrice    Decimal         @default(0.00) @map("unit_price") @db.Decimal(10, 2)
  costPrice    Decimal         @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  sku          String?         @db.VarChar(100)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  logs         ConsumableLog[]

  // Multi-unit configuration fields
  isMultiUnit     Boolean        @default(false) @map("is_multi_unit")
  packageUnitId   Int?           @map("package_unit_id")
  packageUnit     UnitOfMeasure? @relation("PackageUom", fields: [packageUnitId], references: [id], onDelete: SetNull)
  pieceUnitId     Int?           @map("piece_unit_id")
  pieceUnit       UnitOfMeasure? @relation("PieceUom", fields: [pieceUnitId], references: [id], onDelete: SetNull)
  unitRatio       Int            @default(1) @map("unit_ratio")
  packagePrice    Decimal?       @map("package_price") @db.Decimal(10, 2)
  unitOfMeasureId Int?           @map("unit_of_measure_id")
  unitOfMeasure   UnitOfMeasure? @relation("BaseUom", fields: [unitOfMeasureId], references: [id], onDelete: SetNull)

  taxRateId         Int?      @map("tax_rate_id")
  taxRate           TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  // EFRIS T130 -- consumables are sold outright, so they register as goods.
  commodityCode     String?   @map("commodity_code") @db.VarChar(50)
  efrisItemCode     String?   @map("efris_item_code") @db.VarChar(100)
  efrisProductCode  String?   @map("efris_product_code") @db.VarChar(100)
  efrisRegisteredAt DateTime? @map("efris_registered_at")
  haveExciseTax     String?   @map("have_excise_tax") @db.VarChar(4)
  exciseDutyCode    String?   @map("excise_duty_code") @db.VarChar(50)

  bookingLineItems        BookingLineItem[]
  rentalLineItems         RentalLineItem[]
  functionItemAssignments FunctionItemAssignment[]
  invoiceLineItems        InvoiceLineItem[]
  creditNoteLineItems     CreditNoteLineItem[]

  @@map("consumables")
}

model ConsumableLog {
  id           Int        @id @default(autoincrement())
  consumableId Int        @map("consumable_id")
  consumable   Consumable @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  action       String     @db.VarChar(50) // use, restock, write_off, adjustment
  quantity     Int        @default(0)
  operator     String     @db.VarChar(100)
  notes        String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("consumable_logs")
}

model UnitOfMeasure {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(255)
  abbreviation String   @db.VarChar(50)
  category     String   @default("other") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  baseConsumables    Consumable[] @relation("BaseUom")
  packageConsumables Consumable[] @relation("PackageUom")
  pieceConsumables   Consumable[] @relation("PieceUom")

  // EFRIS T115 rateUnit code this local unit maps to (e.g. "101" Kg, "102" Litre).
  efrisCode String? @map("efris_code") @db.VarChar(10)

  bookingLineItems        BookingLineItem[]
  rentalLineItems         RentalLineItem[]
  functionItemAssignments FunctionItemAssignment[]
  invoiceLineItems        InvoiceLineItem[]
  creditNoteLineItems     CreditNoteLineItem[]
  itemsUsingUnit          Item[]                   @relation("ItemUom")
  assetsUsingUnit         SerializedAsset[]        @relation("AssetUom")

  @@map("units_of_measure")
}

model HelpCategory {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  icon        String        @default("HelpCircle") @db.VarChar(50)
  description String        @db.Text
  articles    HelpArticle[]

  @@map("help_categories")
}

model HelpArticle {
  id         Int          @id @default(autoincrement())
  categoryId Int          @map("category_id")
  category   HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String       @db.VarChar(255)
  slug       String       @unique @db.VarChar(255)
  content    String       @db.Text
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("help_articles")
}

model FAQ {
  id           Int     @id @default(autoincrement())
  question     String  @db.VarChar(255)
  answer       String  @db.Text
  displayOrder Int     @default(0) @map("display_order")
  isFeatured   Boolean @default(true) @map("is_featured")

  @@map("faqs")
}

model SystemComponent {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(255)
  description String           @db.Text
  status      String           @default("operational") @db.VarChar(50) // operational, degraded, partial_outage, major_outage, maintenance
  updatedAt   DateTime         @updatedAt @map("updated_at")
  incidents   SystemIncident[]

  @@map("system_components")
}

model SystemIncident {
  id          Int             @id @default(autoincrement())
  componentId Int             @map("component_id")
  component   SystemComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  title       String          @db.VarChar(255)
  severity    String          @default("info") @db.VarChar(50) // info, warning, critical, resolved
  message     String          @db.Text
  reporter    String          @default("system") @db.VarChar(100)
  resolvedAt  DateTime?       @map("resolved_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("system_incidents")
}

// Local index of tickets filed into the central Midway support desk. The desk's
// channel API can read a ticket by ref but has no "list my tickets" endpoint, so we
// remember the refs this tenant opened to power the "My requests" screen. Status is
// a cached copy refreshed whenever the thread is opened — the desk stays the source
// of truth.
model MidwaySupportTicket {
  id        Int      @id @default(autoincrement())
  ref       String   @unique @db.VarChar(32)
  companyId Int?     @map("company_id")
  userId    Int      @map("user_id")
  system    String?  @db.VarChar(191)
  subject   String   @db.VarChar(255)
  status    String   @default("OPEN") @db.VarChar(32)
  priority  String   @default("NORMAL") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, createdAt])
  @@index([userId])
  @@map("midway_support_tickets")
}

// -- TAX & URA EFRIS --------------------------------------------------------

// A tax rate the business defines for itself in Settings. Every company runs its
// own list (a VAT-registered hire firm needs 18% plus zero-rated and exempt; a
// small one may need none), and each rate carries the URA tax-category code that
// EFRIS reports it under.
model TaxRate {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  // Stored as a fraction: 0.1800 = 18%.
  rate      Decimal  @default(0.0000) @db.Decimal(6, 4)
  // EFRIS tax category: 01 standard - 02 zero-rated - 03 exempt - 04 deemed.
  taxCode   String   @default("01") @map("tax_code") @db.VarChar(4)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  items            Item[]
  assets           SerializedAsset[]
  consumables      Consumable[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([companyId, name])
  @@map("tax_rates")
}

// Cache of the URA excise-duty registry (GET /excise-duty). The codes are
// national rather than per-company, so one row per code serves every business on
// the install.
model EfrisExciseCode {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.Text
  rate       String?  @db.VarChar(50)
  unit       String?  @db.VarChar(50)
  currency   String?  @db.VarChar(10)
  // 1 = percentage of value - 2 = fixed amount per unit.
  exciseRule String?  @map("excise_rule") @db.VarChar(4)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("efris_excise_codes")
}

// Log of stock movements reported to URA (T131). Kept so a movement is never
// reported twice, and so failures can be found and retried.
model EfrisStockMovement {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // INCREASE (goods in) or DECREASE (adjustment out).
  direction    String   @db.VarChar(10)
  // Deterministic key of whatever caused the movement (e.g. "PO-14").
  reference    String   @db.VarChar(120)
  // 101 import - 102 local purchase - 103 manufacture - 104 opening stock.
  stockInType  String?  @map("stock_in_type") @db.VarChar(4)
  // 101 expired - 102 damaged - 103 personal use - 104 other - 105 raw materials.
  adjustType   String?  @map("adjust_type") @db.VarChar(4)
  supplierName String?  @map("supplier_name") @db.VarChar(255)
  supplierTin  String?  @map("supplier_tin") @db.VarChar(50)
  remarks      String?  @db.Text
  payload      Json?
  response     Json?
  status       String   @default("PENDING") @db.VarChar(20) // ACCEPTED | FAILED
  error        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyId, reference])
  @@index([status])
  @@map("efris_stock_movements")
}
